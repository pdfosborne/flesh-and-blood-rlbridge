#!/usr/bin/env bash
# Web GUI is served by the fab-bridge container on port 8765.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

# shellcheck source=scripts/docker-gpu-compose.sh
source "$ROOT/scripts/docker-gpu-compose.sh"
fab_docker_gpu_compose_init

if [[ $# -eq 0 ]]; then
  echo "Web GUI: http://localhost:8765"
  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "http://localhost:8765" >/dev/null 2>&1 || true
  elif command -v open >/dev/null 2>&1; then
    open "http://localhost:8765" || true
  fi
  exit 0
fi

SERVICE=fab-bridge

if docker compose ps "$SERVICE" --status running -q 2>/dev/null | grep -q .; then
  exec docker compose exec -it "$SERVICE" fab-gui "$@"
fi

exec docker compose run --rm -it "$SERVICE" fab-gui "$@"
