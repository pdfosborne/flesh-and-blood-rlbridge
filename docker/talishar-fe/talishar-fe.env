# Talishar-FE config for the fab-rl-bridge Docker stack (Vite proxies to web-server).
VITE_ENV="dev"
VITE_BACKEND_URL="web-server"
VITE_BACKEND_PORT="80"
VITE_BACKEND_DIRECTORY="game"
VITE_DATADOLL_URL="web-server"
VITE_DATADOLL_PORT="80"
VITE_ROGUELIKE_URL="web-server"
VITE_ROGUELIKE_PORT="80"
VITE_ROGUELIKE_DIRECTORY="game"
VITE_FREEZE_GAME=false
